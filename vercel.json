{
  "functions": {
    "api/verify.js": { "includeFiles": "assets/MergeMarket.*", "maxDuration": 60 },
    "api/collection.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
